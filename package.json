{
  "name": "HLA-Trans",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"bun run dev:web\" \"bun run dev:worker\"",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "podman compose up -d",
    "db:down": "podman compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:migrate:test": "bun scripts/migrate.ts --test",
    "db:studio": "drizzle-kit studio",
    "test:db": "bun run db:migrate:test && vitest run --config vitest.db.config.ts",
    "worker": "NODE_ENV=production bun src/worker/main.ts",
    "dev:web": "vite dev --port 3000",
    "dev:worker": "bun --watch src/worker/main.ts",
    "perf": "bun scripts/load-test.ts",
    "check:bundle": "bun run build && bun scripts/check-client-bundle.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.73.0",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.22.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/eslint-config": "0.5.0",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^10",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.1.0"
  }
}
